<?php View::push('javascript') ?>
<script>
    'use strict';

    // Issue #31: on phones, keep the existing person-name heading immediately
    // after the portrait. The normal theme enhancement can run after this view,
    // so re-apply the placement once the page has settled rather than moving it
    // only during the initial render.
    (() => {
        const grid = document.querySelector('.potts-profile-grid');
        const photo = grid?.querySelector(':scope > .potts-profile-photo');
        const core = grid?.querySelector(':scope > .potts-profile-core');
        const name = document.querySelector('.potts-profile-name');

        if (!grid || !photo || !core || !name) {
            return;
        }

        const marker = document.createComment('potts-profile-name-original-position');
        core.insertBefore(marker, core.firstChild);

        const phoneLayout = window.matchMedia('(max-width: 767.98px)');
        let placing = false;

        const placeName = () => {
            if (placing) {
                return;
            }

            placing = true;

            if (phoneLayout.matches) {
                if (name.parentElement !== grid || name.previousElementSibling !== photo) {
                    photo.insertAdjacentElement('afterend', name);
                }
            } else if (marker.parentNode) {
                if (name.parentNode !== marker.parentNode || name.previousSibling !== marker) {
                    marker.parentNode.insertBefore(name, marker.nextSibling);
                }
            }

            placing = false;
        };

        const settleName = () => {
            placeName();
            window.requestAnimationFrame(() => window.requestAnimationFrame(placeName));
            window.setTimeout(placeName, 100);
            window.setTimeout(placeName, 350);
            window.setTimeout(placeName, 900);
        };

        settleName();
        window.addEventListener('load', settleName, { once: true });

        const observer = new MutationObserver(() => {
            if (!placing) {
                placeName();
            }
        });
        observer.observe(document.body, { childList: true, subtree: true });
        window.setTimeout(() => observer.disconnect(), 3000);

        if (typeof phoneLayout.addEventListener === 'function') {
            phoneLayout.addEventListener('change', settleName);
        } else if (typeof phoneLayout.addListener === 'function') {
            phoneLayout.addListener(settleName);
        }
    })();

    // Bootstrap tabs - load content dynamically using AJAX.
    $('a[data-bs-toggle="tab"][data-wt-href]').on('show.bs.tab', function () {
        let target = $(this.hash + ':empty');

        if (target.length > 0) {
            // Start the download immediately...
            let download = webtrees.httpGet(this.dataset.wtHref);

            // ...but do not insert it until the tab is ready.
            $(this).one('shown.bs.tab', () => {
                download
                    .then(data => data.text())
                    .then(data => target.html(data));
            });
        }
    });

    // If the URL contains a fragment, activate the corresponding tab.
    // Use a prefix on the fragment to prevent scrolling to the element.
    let target = window.location.hash.replace('tab-', '');
    let tab = document.querySelector("#individual-tabs .nav-link[href='" + target + "']");

    // Otherwise activate the first tab.
    tab = tab ?? document.querySelector('#individual-tabs .nav-link');
    tab?.click();

    // If the user selects a tab, update the URL to reflect this.
    $('#individual-tabs a[data-bs-toggle="tab"]').on('shown.bs.tab', function (event) {
        window.location.hash = 'tab-' + event.target.href.substring(event.target.href.indexOf('#') + 1);
    });
</script>
<?php View::endpush() ?>
