declare(strict_types=1);

use Fisharebest\Webtrees\I18N;

/**
 * @var string $title
 * @var string $action_url
 * @var array<string,string> $settings
 * @var array<string,array<string,string>> $choices
 * @var bool $saved
 * @var bool $reset
