<script>
(function(){
  const utilityControls=Array.from(document.querySelectorAll('a,button')).filter(el=>{
    if(el.closest('.potts-settings-page')){return false;}
    return /^(my page|theme|language|sign out|log out|logout)\b/i.test((el.textContent||'').replace(/\s+/g,' ').trim());
  });
  utilityControls.forEach(el=>{
    el.classList.add('potts-settings-header-link');
    const bar=el.closest('nav,header,.navbar,.wt-header,.wt-header-wrapper,#header,#top-header');
    if(bar){bar.classList.add('potts-settings-header-bar');}
  });
  document.querySelectorAll('[data-potts-preset]').forEach(button=>button.addEventListener('click',()=>{
    const preset=button.dataset.pottsPreset;
    const values={
      storytelling:{homepage_style:'storytelling',content_spacing:'comfortable',show_welcome_panel:true,show_home_search:true,potts_experience:true},
      classic:{homepage_style:'classic',content_spacing:'comfortable',show_welcome_panel:false,show_home_search:false,potts_experience:true},
      compact:{homepage_style:'compact',content_spacing:'compact',show_welcome_panel:true,show_home_search:true,potts_experience:true}
    }[preset];
    Object.entries(values).forEach(([name,value])=>{
      const control=document.querySelector('[name="'+name+'"]');
      if(!control){return;}
      if(control.type==='checkbox'){control.checked=Boolean(value);}else{control.value=String(value);}
      control.dispatchEvent(new Event('change',{bubbles:true}));
    });
  }));
  const preview=document.getElementById('potts-theme-preview');
  if(!preview){return;}
  const palettes={heritage:{bg:'#edf1e9',bg2:'#fbfcf7',ink:'#26352e',muted:'#66736c',accent:'#416b56',dark:'#203e34',gold:'#a88a52',sage:'#dfe8dc'},ocean:{bg:'#eaf1f6',bg2:'#fbfdff',ink:'#20313d',muted:'#61727e',accent:'#246f98',dark:'#17455f',gold:'#b18b45',sage:'#dfe9ee'},claret:{bg:'#f2ece8',bg2:'#fffaf4',ink:'#342b2d',muted:'#74676a',accent:'#743c4a',dark:'#4d2731',gold:'#aa8954',sage:'#e4e8dc'},purple:{bg:'#f1edf5',bg2:'#fdfbff',ink:'#302b38',muted:'#6d6676',accent:'#6b4f83',dark:'#453355',gold:'#b08a4d',sage:'#e8e2ee'},slate:{bg:'#edf0f2',bg2:'#fcfdfe',ink:'#29343b',muted:'#67737a',accent:'#536b78',dark:'#344650',gold:'#a9864b',sage:'#e1e7ea'},teal:{bg:'#eaf3f1',bg2:'#fbfefd',ink:'#203633',muted:'#607672',accent:'#2c786f',dark:'#194c47',gold:'#af8b45',sage:'#dcebe7'},sandstone:{bg:'#eee4d3',bg2:'#fffaf1',ink:'#3d3026',muted:'#786a5d',accent:'#765038',dark:'#4e3424',gold:'#b27b33',sage:'#e7e5d7'}};
  function refresh(){
    const palette=document.querySelector('[name="palette"]:checked')?.value || 'heritage';
    const corners=document.querySelector('[name="corners"]').value;
    const shadows=document.querySelector('[name="shadows"]').value;
    const text=document.querySelector('[name="text_size"]').value;
    const weight=document.querySelector('[name="font_weight"]').value;
    const p=palettes[palette];
    const radius={soft:'20px',moderate:'13px',square:'3px'}[corners];
    const shadow={soft:'0 18px 42px rgba(35,48,56,.12)',strong:'0 22px 55px rgba(35,48,56,.22)',none:'none'}[shadows];
    preview.style.background='linear-gradient(180deg,'+p.bg2+','+p.bg+')';
    preview.style.color=p.ink;
    preview.style.borderRadius=radius;
    preview.style.boxShadow=shadow;
    preview.style.fontSize=text==='large'?'1.075rem':'1rem';
    const weights={light:{heading:'650',nav:'600',label:'600'},standard:{heading:'800',nav:'700',label:'700'},bold:{heading:'850',nav:'800',label:'750'}}[weight];
    preview.querySelectorAll('.potts-preview-title,.potts-preview-card h4').forEach(el=>el.style.fontWeight=weights.heading);
    preview.querySelectorAll('.potts-preview-nav span,.potts-submenu-demo div').forEach(el=>el.style.fontWeight=weights.nav);
    preview.querySelectorAll('.potts-preview-chips span').forEach(el=>el.style.fontWeight=weights.label);
    preview.querySelector('.potts-preview-header').style.background='linear-gradient(135deg,'+p.dark+','+p.accent+')';
    preview.querySelectorAll('.potts-preview-card').forEach(el=>{el.style.borderRadius=radius;el.style.boxShadow=shadow;});
    preview.querySelectorAll('.potts-preview-chips span,.potts-submenu-demo i').forEach(el=>{el.style.background=p.sage;el.style.color=p.accent;});
    preview.querySelector('.potts-submenu-demo').style.background=p.bg2;
  }
  document.querySelectorAll('[data-potts-setting]').forEach(el=>el.addEventListener('change',refresh));
  refresh();
})();
</script>
