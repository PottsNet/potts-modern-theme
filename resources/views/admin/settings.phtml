 */

$select = static function (string $key, string $label, string $help) use ($settings, $choices): void {
    $name = strtolower($key);
    ?>
    <div class="potts-setting-field">
        <label class="form-label" for="potts-<?= e($name) ?>"><?= e($label) ?></label>
        <select class="form-select" id="potts-<?= e($name) ?>" name="<?= e($name) ?>" data-potts-setting="<?= e($name) ?>">
            <?php foreach ($choices[$key] as $value => $option) : ?>
                <option value="<?= e($value) ?>" <?= $settings[$key] === $value ? 'selected' : '' ?>><?= e($option) ?></option>
            <?php endforeach ?>
        </select>
        <div class="form-text"><?= e($help) ?></div>
    </div>
    <?php
};


$textField = static function (string $key, string $label, string $help, bool $multiline = false) use ($settings): void {
    $name = strtolower($key);
    ?>
    <div class="potts-setting-field <?= $multiline ? 'potts-setting-field-wide' : '' ?>">
        <label class="form-label" for="potts-<?= e($name) ?>"><?= e($label) ?></label>
        <?php if ($multiline) : ?>
            <textarea class="form-control" rows="3" id="potts-<?= e($name) ?>" name="<?= e($name) ?>" data-potts-setting="<?= e($name) ?>"><?= e($settings[$key]) ?></textarea>
        <?php else : ?>
            <input class="form-control" type="text" id="potts-<?= e($name) ?>" name="<?= e($name) ?>" value="<?= e($settings[$key]) ?>" data-potts-setting="<?= e($name) ?>">
        <?php endif ?>
        <div class="form-text"><?= e($help) ?></div>
    </div>
    <?php
};

$paletteCards = static function () use ($settings): void {
    $palettes = [
        'heritage'  => [I18N::translate('Potts Green'), '#203e34', '#416b56', '#a88a52', '#edf1e9'],
        'ocean'     => [I18N::translate('Ocean Blue'), '#17455f', '#246f98', '#b18b45', '#eaf1f6'],
        'claret'    => [I18N::translate('Burgundy'), '#4d2731', '#743c4a', '#aa8954', '#f2ece8'],
        'purple'    => [I18N::translate('Heritage Purple'), '#453355', '#6b4f83', '#b08a4d', '#f1edf5'],
        'slate'     => [I18N::translate('Slate'), '#344650', '#536b78', '#a9864b', '#edf0f2'],
        'teal'      => [I18N::translate('Teal'), '#194c47', '#2c786f', '#af8b45', '#eaf3f1'],
        'sandstone' => [I18N::translate('Sandstone'), '#4e3424', '#765038', '#b27b33', '#eee4d3'],
    ];
    ?>
    <fieldset class="potts-palette-fieldset">
        <legend class="form-label"><?= e(I18N::translate('Colour preset')) ?></legend>
        <div class="potts-palette-grid">
            <?php foreach ($palettes as $value => [$label, $dark, $accent, $gold, $background]) : ?>
                <label class="potts-palette-card">
                    <input type="radio" name="palette" value="<?= e($value) ?>" data-potts-setting="palette" <?= $settings['PALETTE'] === $value ? 'checked' : '' ?>>
                    <span class="potts-palette-swatch" style="--swatch-dark:<?= e($dark) ?>;--swatch-accent:<?= e($accent) ?>;--swatch-gold:<?= e($gold) ?>;--swatch-bg:<?= e($background) ?>">
                        <i></i><i></i><i></i><i></i>
                    </span>
                    <strong><?= e($label) ?></strong>
                </label>
            <?php endforeach ?>
        </div>
        <div class="form-text"><?= e(I18N::translate('Choose a complete colour scheme for the header, navigation, cards and page background.')) ?></div>
    </fieldset>
    <?php
};

$toggle = static function (string $key, string $label, string $help) use ($settings): void {
    $name = strtolower($key);
    ?>
    <label class="potts-setting-toggle" for="potts-<?= e($name) ?>">
